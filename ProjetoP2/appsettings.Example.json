{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "MassTransit": "Information"
            }
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=localhost,1433;Database=YourDatabase;User Id=YourUser;Password=YourPassword123;TrustServerCertificate=True"
    },
    "RabbitMq": {
        "Host": "localhost"
    },
    "Jwt": {
        "SecretKey": "VeterinaryConsultationApp-secret-key-minimum-32-characters-long",
        "Issuer": "VeterinaryConsultationApp",
        "Audience": "VeterinaryConsultationApp",
        "ExpirationHours": 1
    }
}