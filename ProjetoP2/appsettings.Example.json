{
    // Renomear este arquivo para appsettings.Development.json e alterar dados abaixo
    "ConnectionStrings": {
        // Altere DATABASE_NAME para o nome que quiser, USER para o seu user do PostGreSQL e PASSWORD para a sua senha do PostGreSQL
        "DefaultConnection": "Host=localhost;Port=5432;Database=DATABASE_NAME;Username=USER;Password=PASSWORD"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    }
}
